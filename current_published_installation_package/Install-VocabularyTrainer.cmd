:::foreach ($target in @($startLnk, $desktopLnk)) {
:::    try {
:::        $lnk = $shell.CreateShortcut($target)
:::        $lnk.TargetPath = $VenvPyw
:::        $lnk.Arguments = '-m vocabulary_trainer'
:::        $lnk.WorkingDirectory = $InstallRoot
:::        $lnk.Description = $AppName + ' ' + $AppVersion
:::        if (Test-Path $IconPath) { $lnk.IconLocation = $IconPath }
:::        $lnk.Save()
