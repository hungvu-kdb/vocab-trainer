:: ===========================================================================
:: Vocabulary Trainer 2.0.0 -- installer
::
:: Just double-click this file. It installs for the current user only and asks
:: no administrator rights. Nothing outside your own profile is touched.
::
:: This is a single self-contained file: the application itself is embedded
:: below as text. Do not edit it -- any change breaks the embedded payload.
:: ===========================================================================
@echo off
setlocal
title Vocabulary Trainer 2.0.0 -- installer
if not "%~1"=="--elevated-noop" goto :launch
:launch
where powershell.exe >nul 2>nul
if errorlevel 1 (
  echo.
  echo   Windows PowerShell was not found on this machine, so this installer
  echo   cannot run. PowerShell ships with Windows 7 and later; if it has been
  echo   removed or blocked, ask whoever manages this computer.
  echo.
  pause
  exit /b 1
)
set "VT_SELF=%~f0"
powershell.exe -NoProfile -NoLogo -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $lines=[IO.File]::ReadAllLines($env:VT_SELF); $s=[Array]::IndexOf($lines,'#PSBEGIN'); $e=[Array]::IndexOf($lines,'#PSEND'); if($s -lt 0 -or $e -le $s){ Write-Host '  This installer file is damaged (script section missing).' -ForegroundColor Red; exit 1 }; $src=($lines[($s+1)..($e-1)] | ForEach-Object { $_ -replace '^:::','' }) -join [Environment]::NewLine; & ([scriptblock]::Create($src))"
set "VT_EXIT=%ERRORLEVEL%"
if not "%VT_EXIT%"=="0" (
  echo.
  pause
)
exit /b %VT_EXIT%
#PSBEGIN
:::# ---------------------------------------------------------------------------
:::# Vocabulary Trainer v3 - installer body.
:::#
:::# This file is NOT run directly. build_installer.py embeds it, plus a base64
:::# payload (the app wheel + icon), into a single self-extracting
:::# Install-VocabularyTrainer.cmd that is the only file an end user needs.
:::#
:::# Constraints, because of how it is embedded:
:::#   * ASCII only. The generated .cmd is written as ASCII so cmd.exe parses it
:::#     predictably on any codepage.
:::#   * No line may be exactly "#PSBEGIN", "#PSEND", "#B64BEGIN" or "#B64END" --
:::#     the cmd stub and this script locate their regions by exact line match.
:::# ---------------------------------------------------------------------------
:::
:::$ErrorActionPreference = 'Stop'
:::[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
:::
:::$AppName      = 'Vocabulary Trainer'
:::$AppVersion   = '2.0.0'
:::$WheelName    = 'vocab_v2-2.0.0-py3-none-any.whl'
:::$PyFallback   = '3.12.10'
:::$MinPy        = [Version]'3.12'
:::
:::$InstallRoot  = Join-Path $env:LOCALAPPDATA 'VocabularyTrainer'
:::$RuntimeDir   = Join-Path $InstallRoot 'runtime'
:::$VenvPy       = Join-Path $RuntimeDir 'Scripts\python.exe'
:::$VenvPyw      = Join-Path $RuntimeDir 'Scripts\pythonw.exe'
:::$IconPath     = Join-Path $InstallRoot 'app.ico'
:::$UninstallCmd = Join-Path $InstallRoot 'uninstall.cmd'
:::$RegKey       = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\VocabularyTrainerV3'
:::$StartMenu    = Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs'
:::$UserData     = Join-Path $env:APPDATA 'VocabularyTrainer'
:::$Work         = Join-Path ([IO.Path]::GetTempPath()) ('vt3-install-' + [Guid]::NewGuid().ToString('N').Substring(0, 8))
:::
:::function Write-Step { param([string]$Text) Write-Host ''; Write-Host ('==> ' + $Text) -ForegroundColor Cyan }
:::function Write-Info { param([string]$Text) Write-Host ('    ' + $Text) -ForegroundColor Gray }
:::function Write-Good { param([string]$Text) Write-Host ('    ' + $Text) -ForegroundColor Green }
:::function Write-Warn { param([string]$Text) Write-Host ('    ' + $Text) -ForegroundColor Yellow }
:::
:::# Runs an external program without letting its stderr become a fatal error.
:::#
:::# $ErrorActionPreference = 'Stop' is right for cmdlets but wrong for native
:::# commands: PowerShell wraps anything they write to stderr in a NativeCommandError
:::# and, under 'Stop', kills the script. pip uses stderr for ordinary notices --
:::# "Skipping vocab-v2 as it is not installed", "A new release of pip is
:::# available" -- so a perfectly healthy install would abort on a warning. Success
:::# is judged by exit code instead, which is the only reliable signal.
:::function Invoke-Native {
:::    param(
:::        [Parameter(Mandatory = $true)][string]$File,
:::        [string[]]$Arguments = @(),
:::        [switch]$Silent
:::    )
:::    $previous = $ErrorActionPreference
:::    $ErrorActionPreference = 'Continue'
:::    try {
:::        if ($Silent) {
:::            & $File @Arguments 2>&1 | Out-Null
:::        } else {
:::            & $File @Arguments 2>&1 | ForEach-Object { Write-Host $_ }
:::        }
:::        return $LASTEXITCODE
:::    } finally {
:::        $ErrorActionPreference = $previous
:::    }
:::}
:::
:::function Stop-WithError {
:::    param([string]$Text, [string[]]$Hints = @())
:::    Write-Host ''
:::    Write-Host ('  Install failed: ' + $Text) -ForegroundColor Red
:::    foreach ($h in $Hints) { Write-Host ('  - ' + $h) -ForegroundColor Yellow }
:::    Write-Host ''
:::    Write-Host '  Nothing was left half-installed that you need to clean up by hand;' -ForegroundColor Gray
:::    Write-Host ('  you can re-run this installer once the above is sorted.') -ForegroundColor Gray
:::    if (Test-Path $Work) { Remove-Item $Work -Recurse -Force -ErrorAction SilentlyContinue }
:::    exit 1
:::}
:::
:::Write-Host ''
:::Write-Host ('  ' + $AppName + ' ' + $AppVersion) -ForegroundColor White
:::Write-Host '  ------------------------------------------------------------' -ForegroundColor DarkGray
:::Write-Host '  Installs for the current user only. No administrator rights,' -ForegroundColor Gray
:::Write-Host '  no changes outside your own profile.' -ForegroundColor Gray
:::Write-Host ('  Location: ' + $InstallRoot) -ForegroundColor Gray
:::Write-Host '  An internet connection is needed to fetch Qt and the other' -ForegroundColor Gray
:::Write-Host '  Python dependencies (roughly 150 MB on a first install).' -ForegroundColor Gray
:::
:::# --- 0. Environment sanity -------------------------------------------------
:::
:::Write-Step 'Checking this machine'
:::
:::if ([Environment]::OSVersion.Platform -ne 'Win32NT') {
:::    Stop-WithError 'this application is Windows only.'
:::}
:::if (-not [Environment]::Is64BitOperatingSystem) {
:::    Stop-WithError 'a 64-bit version of Windows is required.'
:::}
:::Write-Good ('Windows ' + [Environment]::OSVersion.Version + ', 64-bit.')
:::
:::# A running copy holds its own DLLs open, which would make pip fail halfway
:::# through replacing them. Better to find out now than mid-install.
:::#
:::# Matching on the command line, not just the executable path: a venv's
:::# pythonw.exe is a redirector that re-execs the *base* interpreter, so the
:::# process actually running the app lives outside this folder while still holding
:::# the venv's DLLs open. Path-only matching finds the redirector and misses the
:::# real one. Verified on a live install (venv pythonw -> C:\PythonXXX\pythonw.exe).
:::$running = @()
:::try {
:::    $running = @(Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object {
:::            ($_.ExecutablePath -and $_.ExecutablePath.StartsWith($RuntimeDir, 'OrdinalIgnoreCase')) -or
:::            ($_.CommandLine -and $_.CommandLine -like '*vocabulary_trainer*' -and $_.Name -like 'python*')
:::        })
:::} catch { $running = @() }
:::
:::if ($running.Count -gt 0) {
:::    Write-Warn ('' + $AppName + ' is currently running (' + $running.Count + ' process(es)).')
:::    $answer = Read-Host '    Close it now and continue? [Y/n]'
:::    if ($answer -and $answer.Trim().ToLower().StartsWith('n')) {
:::        Stop-WithError 'the application must be closed before it can be replaced.' @(
:::            'Quit it from the floating character''s menu or the tray icon, then re-run.')
:::    }
:::    foreach ($p in $running) { Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue }
:::    Start-Sleep -Seconds 2
:::    Write-Good 'Closed.'
:::}
:::
:::# --- 1. Unpack the embedded payload ---------------------------------------
:::
:::Write-Step 'Unpacking the application'
:::
:::$selfPath = $env:VT_SELF
:::if (-not $selfPath -or -not (Test-Path $selfPath)) {
:::    Stop-WithError 'could not locate the installer file itself.'
:::}
:::
:::$lines = [IO.File]::ReadAllLines($selfPath)
:::$b64Start = [Array]::IndexOf($lines, '#B64BEGIN')
:::$b64End = [Array]::IndexOf($lines, '#B64END')
:::if ($b64Start -lt 0 -or $b64End -le $b64Start) {
:::    Stop-WithError 'the embedded payload is missing.' @(
:::        'The file was probably truncated or edited in transit. Ask for a fresh copy.')
:::}
:::
:::New-Item -ItemType Directory -Path $Work -Force | Out-Null
:::$zipPath = Join-Path $Work 'payload.zip'
:::try {
:::    $b64 = [string]::Concat($lines[($b64Start + 1)..($b64End - 1)])
:::    [IO.File]::WriteAllBytes($zipPath, [Convert]::FromBase64String($b64))
:::    $b64 = $null
:::    Expand-Archive -LiteralPath $zipPath -DestinationPath $Work -Force
:::} catch {
:::    Stop-WithError ('the embedded payload could not be read (' + $_.Exception.Message + ').') @(
:::        'The file is likely corrupt. Ask for a fresh copy, and avoid sending it',
:::        'through anything that rewrites text files (some chat clients do).')
:::}
:::
:::$wheelPath = Join-Path $Work $WheelName
:::if (-not (Test-Path $wheelPath)) { Stop-WithError 'the application package is missing from the payload.' }
:::Write-Good ('Extracted ' + $WheelName + '.')
:::
:::# --- 2. Find or install Python -------------------------------------------
:::
:::Write-Step 'Looking for Python 3.12 or newer'
:::
:::# The probe is written to a temp .py file rather than passed with -c on purpose.
:::# Windows PowerShell 5.1 mangles an argument containing double quotes when it
:::# rebuilds the native command line, so a -c probe silently returns nothing and
:::# every Python on the machine looks absent. A script file has no quoting to get
:::# wrong. Verified against 3.14 / py -3.14 / py -3 on a real machine.
:::$ProbeFile = $null
:::function Get-ProbeFile {
:::    if ($script:ProbeFile -and (Test-Path $script:ProbeFile)) { return $script:ProbeFile }
:::    $script:ProbeFile = Join-Path $Work 'probe.py'
:::    $body = @(
:::        'import sys',
:::        'print(sys.version_info[0])',
:::        'print(sys.version_info[1])',
:::        'print(sys.maxsize > 2**32)',
:::        'print(sys.executable)'
:::    ) -join [Environment]::NewLine
:::    [IO.File]::WriteAllText($script:ProbeFile, $body, [Text.Encoding]::ASCII)
:::    return $script:ProbeFile
:::}
:::
:::function Test-Python {
:::    param([string]$Exe, [string[]]$PreArgs = @())
:::    $previous = $ErrorActionPreference
:::    $ErrorActionPreference = 'Continue'
:::    try {
:::        $out = @(& $Exe @PreArgs (Get-ProbeFile) 2>$null)
:::        if ($LASTEXITCODE -ne 0 -or $out.Count -lt 4) { return $null }
:::        $ver = [Version]($out[0].Trim() + '.' + $out[1].Trim())
:::        if ($ver -lt $MinPy) { return $null }
:::        # 32-bit Python cannot load the 64-bit-only PySide6 wheels.
:::        if ($out[2].Trim() -ne 'True') { return $null }
:::        return [pscustomobject]@{ Exe = $Exe; PreArgs = $PreArgs; Version = $ver; Real = $out[3].Trim() }
:::    } catch {
:::        return $null
:::    } finally {
:::        $ErrorActionPreference = $previous
:::    }
:::}
:::
:::function Find-Python {
:::    $candidates = @(
:::        @{ Exe = 'py'; Args = @('-3.14') },
:::        @{ Exe = 'py'; Args = @('-3.13') },
:::        @{ Exe = 'py'; Args = @('-3.12') },
:::        @{ Exe = 'py'; Args = @('-3') },
:::        @{ Exe = 'python'; Args = @() },
:::        @{ Exe = 'python3'; Args = @() }
:::    )
:::    foreach ($root in @($env:LOCALAPPDATA, $env:ProgramFiles)) {
:::        if (-not $root) { continue }
:::        $dir = Join-Path $root 'Programs\Python'
:::        if (Test-Path $dir) {
:::            foreach ($d in Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending) {
:::                $candidates += @{ Exe = (Join-Path $d.FullName 'python.exe'); Args = @() }
:::            }
:::        }
:::        foreach ($n in @('Python314', 'Python313', 'Python312')) {
:::            $candidates += @{ Exe = (Join-Path $root ($n + '\python.exe')); Args = @() }
:::        }
:::    }
:::    foreach ($c in $candidates) {
:::        if ($c.Exe -match '\\' -and -not (Test-Path $c.Exe)) { continue }
:::        $found = Test-Python -Exe $c.Exe -PreArgs $c.Args
:::        if ($found) { return $found }
:::    }
:::    return $null
:::}
:::
:::$python = Find-Python
:::
:::if (-not $python) {
:::    Write-Warn 'No suitable Python found.'
:::    Write-Info ('This installer can download Python ' + $PyFallback + ' from python.org and')
:::    Write-Info 'install it for your user account only (it will not change your PATH).'
:::    $answer = Read-Host '    Download and install it now? [Y/n]'
:::    if ($answer -and $answer.Trim().ToLower().StartsWith('n')) {
:::        Stop-WithError 'Python 3.12 or newer is required.' @(
:::            'Install it from https://www.python.org/downloads/windows/ and re-run this file.')
:::    }
:::
:::    $url = 'https://www.python.org/ftp/python/' + $PyFallback + '/python-' + $PyFallback + '-amd64.exe'
:::    $exe = Join-Path $Work ('python-' + $PyFallback + '-amd64.exe')
:::    Write-Info ('Downloading ' + $url)
:::    try {
:::        $progressPreference = 'SilentlyContinue'
:::        Invoke-WebRequest -Uri $url -OutFile $exe -UseBasicParsing
:::    } catch {
:::        Stop-WithError ('the Python download failed (' + $_.Exception.Message + ').') @(
:::            'Check your internet connection or proxy, or install Python 3.12+ manually',
:::            'from https://www.python.org/downloads/windows/ and re-run this file.')
:::    }
:::
:::    Write-Info 'Installing Python (this takes a minute, no window will appear)...'
:::    # InstallAllUsers=0 plus InstallLauncherAllUsers=0 keeps the whole thing inside
:::    # this user's profile, which is what avoids an admin prompt. PrependPath=0
:::    # because the app runs from its own venv and has no business editing PATH.
:::    $pyArgs = @('/quiet', 'InstallAllUsers=0', 'InstallLauncherAllUsers=0', 'PrependPath=0',
:::                'Include_launcher=1', 'Include_pip=1', 'Include_test=0',
:::                'AssociateFiles=0', 'Shortcuts=0')
:::    $proc = Start-Process -FilePath $exe -ArgumentList $pyArgs -Wait -PassThru
:::    if ($proc.ExitCode -ne 0 -and $proc.ExitCode -ne 3010) {
:::        Stop-WithError ('the Python installer exited with code ' + $proc.ExitCode + '.') @(
:::            'Install Python 3.12+ manually from python.org, then re-run this file.')
:::    }
:::    # A fresh install is not on this process's inherited PATH yet.
:::    $env:PATH = ([Environment]::GetEnvironmentVariable('PATH', 'Machine') + ';' +
:::                 [Environment]::GetEnvironmentVariable('PATH', 'User'))
:::    $python = Find-Python
:::    if (-not $python) {
:::        Stop-WithError 'Python was installed but could not be located afterwards.' @(
:::            'Sign out and back in (or reboot), then re-run this file.')
:::    }
:::}
:::
:::Write-Good ('Using Python ' + $python.Version + ' at ' + $python.Real)
:::
:::# --- 3. Private virtual environment --------------------------------------
:::
:::Write-Step 'Preparing a private Python environment'
:::Write-Info 'Kept separate from any Python you use for your own work, so this'
:::Write-Info 'app can never disturb your other projects.'
:::
:::$venvOk = $false
:::if (Test-Path $VenvPy) {
:::    $existing = Test-Python -Exe $VenvPy
:::    if ($existing) {
:::        $venvOk = $true
:::        Write-Good 'Reusing the environment from a previous install.'
:::    } else {
:::        Write-Warn 'The previous environment is unusable; rebuilding it.'
:::        Remove-Item $RuntimeDir -Recurse -Force -ErrorAction SilentlyContinue
:::    }
:::}
:::
:::if (-not $venvOk) {
:::    New-Item -ItemType Directory -Path $InstallRoot -Force | Out-Null
:::    $code = Invoke-Native -File $python.Exe -Arguments (@($python.PreArgs) + @('-m', 'venv', $RuntimeDir))
:::    if ($code -ne 0 -or -not (Test-Path $VenvPy)) {
:::        Stop-WithError 'the Python environment could not be created.' @(
:::            'If this Python came from the Microsoft Store, install it from python.org instead.')
:::    }
:::    Write-Good 'Created.'
:::}
