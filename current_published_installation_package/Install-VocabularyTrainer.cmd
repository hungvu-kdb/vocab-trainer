:::    Replace('__INSTALLROOTQ__', $InstallRoot).
:::    Replace('__INSTALLROOT__', $InstallRoot).
:::    Replace('__STARTMENULNK__', $startLnk).
:::    Replace('__DESKTOPLNK__', $desktopLnk).
:::    Replace('__USERDATA__', $UserData)
:::[IO.File]::WriteAllText($UninstallCmd, $uninstallText, [Text.Encoding]::ASCII)
:::
