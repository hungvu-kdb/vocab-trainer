:::# --- 4. Install the application ------------------------------------------
:::
:::Write-Step 'Installing the application and its dependencies'
:::Write-Info 'Downloading Qt and friends from PyPI. First run is the slow one;'
:::Write-Info 'later re-installs reuse the download cache.'
:::Write-Host ''
:::
:::Invoke-Native -File $VenvPy -Silent -Arguments @(
:::    '-m', 'pip', 'install', '--disable-pip-version-check', '--no-input',
:::    '--quiet', '--upgrade', 'pip', 'setuptools') | Out-Null
:::
:::# Drop any previous copy of the app first. Without this, re-installing the same
:::# version number makes pip skip the wheel ("already installed with the same
:::# version") -- which both leaves the old code in place and prints a line that
:::# reads like a failure to whoever is watching. Removing it first means one pip
:::# pass does everything, and the code is always genuinely replaced. Dependencies
:::# are untouched by the uninstall, so a re-install stays fast. On a fresh venv
:::# there is nothing to remove and pip says so on stderr; that is expected, hence
:::# -Silent and the ignored exit code.
:::Invoke-Native -File $VenvPy -Silent -Arguments @(
:::    '-m', 'pip', 'uninstall', '--disable-pip-version-check', '--quiet', '-y', 'vocab-v2') | Out-Null
:::
:::$code = Invoke-Native -File $VenvPy -Arguments @(
:::    '-m', 'pip', 'install', '--disable-pip-version-check', '--no-input', $wheelPath)
:::if ($code -ne 0) {
:::    Stop-WithError 'the application or its dependencies failed to install.' @(
:::        'This is nearly always a network, proxy or corporate-firewall problem.',
:::        'If you use a proxy, set HTTPS_PROXY in your environment and re-run.')
:::}
:::
:::Write-Step 'Verifying the install'
:::# Same temp-file reason as Test-Python: no quotes on the command line to mangle.
:::# Imports the real UI entry points too, since a broken QtWebEngine (a missing VC++
:::# runtime, most often) only shows up when that module is actually loaded.
:::$checkFile = Join-Path $Work 'verify.py'
:::[IO.File]::WriteAllText($checkFile, (@(
:::    'import vocabulary_trainer',
:::    'import openpyxl, httpx',
:::    'from PySide6.QtWidgets import QApplication',
:::    'from PySide6.QtWebEngineWidgets import QWebEngineView',
:::    'from vocabulary_trainer.app import main',
:::    'print(chr(111) + chr(107))'
:::) -join [Environment]::NewLine), [Text.Encoding]::ASCII)
:::
:::$ErrorActionPreference = 'Continue'
:::$check = @(& $VenvPy $checkFile 2>&1)
:::$checkCode = $LASTEXITCODE
:::$ErrorActionPreference = 'Stop'
:::if ($checkCode -ne 0 -or ($check -join ' ') -notmatch 'ok') {
:::    Write-Host ''
:::    Write-Host ($check -join [Environment]::NewLine) -ForegroundColor DarkGray
:::    Stop-WithError 'the installed application could not be loaded.' @(
:::        'If the error above mentions a missing DLL, install the Microsoft Visual',
:::        'C++ 2015-2022 Redistributable (x64) from microsoft.com and re-run this file.')
:::}
:::Write-Good 'All components load correctly.'
:::
:::# --- 5. Icon, shortcuts, uninstaller -------------------------------------
:::
:::Write-Step 'Creating shortcuts'
:::
:::$payloadIcon = Join-Path $Work 'app.ico'
:::if (Test-Path $payloadIcon) { Copy-Item $payloadIcon $IconPath -Force }
:::
:::# The uninstaller copies itself to %TEMP% and re-runs from there before deleting
:::# anything. It has to: it lives inside the very folder it removes, and cmd.exe
:::# reads a batch file incrementally as it executes -- delete the file mid-run and
:::# cmd aborts with "The system cannot find the path specified". The copy is keyed
:::# off its own location rather than a flag, so running it in place by hand (or with
:::# any arguments at all) still takes the safe path.
:::$uninstallText = @'
:::@echo off
:::rem Uninstaller for __APPNAME__ __APPVERSION__.
:::rem Removes the application. Your words and settings are deliberately kept.
:::setlocal enableextensions
:::cd /d "%TEMP%"
:::
:::rem Still inside the folder about to be deleted? Relocate and hand over.
:::echo "%~dp0" | findstr /i /c:"__INSTALLROOTQ__" >nul
:::if errorlevel 1 goto :run
:::set "COPY=%TEMP%\vt3-uninstall-%RANDOM%%RANDOM%.cmd"
:::copy /y "%~f0" "%COPY%" >nul
:::if errorlevel 1 (
:::  echo Could not prepare the uninstaller in %TEMP%.
:::  pause
:::  exit /b 1
:::)
:::start "" cmd /c ""%COPY%""
:::exit /b 0
:::
::::run
:::echo.
:::echo Removing __APPNAME__...
:::rem No pipe characters in the -Command argument: cmd would treat them as its own
:::rem redirection even inside quotes, so a foreach loop replaces the pipeline.
:::rem Matches the command line as well as the path, because a venv's pythonw.exe
:::rem re-execs the base interpreter -- the process really running the app sits
:::rem outside this folder while still holding its DLLs open.
:::powershell -NoProfile -ExecutionPolicy Bypass -Command "$r='__INSTALLROOT__'; foreach($p in @(Get-CimInstance Win32_Process -ErrorAction SilentlyContinue)){ $hit=$false; if($p.ExecutablePath -and $p.ExecutablePath.StartsWith($r,'OrdinalIgnoreCase')){ $hit=$true }; if($p.Name -like 'python*' -and $p.CommandLine -and $p.CommandLine -like '*vocabulary_trainer*'){ $hit=$true }; if($hit){ Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue } }"
:::rem ping, not timeout: timeout fails outright when stdin is redirected.
:::ping -n 3 127.0.0.1 >nul 2>nul
:::del /f /q "__STARTMENULNK__" >nul 2>nul
:::del /f /q "__DESKTOPLNK__" >nul 2>nul
:::reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\VocabularyTrainerV3" /f >nul 2>nul
:::rmdir /s /q "__INSTALLROOT__" >nul 2>nul
:::if exist "__INSTALLROOT__" (
:::  echo.
:::  echo Some files could not be removed -- something in the folder is still open.
:::  echo Close __APPNAME__, sign out and back in, then delete this folder by hand:
:::  echo   __INSTALLROOT__
:::) else (
:::  echo Removed.
:::)
:::echo.
:::echo Your vocabulary workbook and settings were kept at:
:::echo   __USERDATA__
:::echo Delete that folder yourself if you want them gone too.
:::echo.
:::pause
:::rem Deletes the %TEMP% copy; harmless if it is the last line executed.
:::(goto) 2>nul & del /f /q "%~f0"
:::'@
:::
:::$startLnk = Join-Path $StartMenu ($AppName + '.lnk')
:::$desktopLnk = Join-Path ([Environment]::GetFolderPath('Desktop')) ($AppName + '.lnk')
:::
:::$uninstallText = $uninstallText.Replace('__APPNAME__', $AppName).
