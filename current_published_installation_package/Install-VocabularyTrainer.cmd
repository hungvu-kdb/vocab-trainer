:::        Write-Warn ('Could not create ' + $target + ' (' + $_.Exception.Message + ')')
:::    }
:::}
:::
:::New-Item -Path $RegKey -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'DisplayName' -Value $AppName -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'DisplayVersion' -Value $AppVersion -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'Publisher' -Value 'Vocabulary Trainer' -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'InstallLocation' -Value $InstallRoot -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'DisplayIcon' -Value $IconPath -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'UninstallString' -Value ('cmd.exe /c "' + $UninstallCmd + '"') -PropertyType String -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'NoModify' -Value 1 -PropertyType DWord -Force | Out-Null
:::New-ItemProperty -Path $RegKey -Name 'NoRepair' -Value 1 -PropertyType DWord -Force | Out-Null
:::Write-Good 'Listed in Settings > Apps > Installed apps.'
:::
:::Remove-Item $Work -Recurse -Force -ErrorAction SilentlyContinue
:::
:::# --- 6. Done ---------------------------------------------------------------
:::
:::Write-Host ''
:::Write-Host '  ------------------------------------------------------------' -ForegroundColor DarkGray
:::Write-Host ('  ' + $AppName + ' is installed.') -ForegroundColor Green
:::Write-Host ''
:::Write-Host '  There is no main window, by design. When it starts you get a' -ForegroundColor Gray
:::Write-Host '  floating character near the bottom-right of your screen and an' -ForegroundColor Gray
:::Write-Host '  icon in the notification area. Click either one for the menu.' -ForegroundColor Gray
:::Write-Host ''
:::Write-Host ('  Your words live in ' + (Join-Path $UserData 'master.xlsx')) -ForegroundColor Gray
:::Write-Host '  and can be opened in Excel at any time.' -ForegroundColor Gray
:::Write-Host ''
:::Write-Host ('  To remove it later: Settings > Apps, or run') -ForegroundColor Gray
:::Write-Host ('  ' + $UninstallCmd) -ForegroundColor Gray
:::Write-Host ''
:::
:::$answer = Read-Host '  Start it now? [Y/n]'
:::if (-not ($answer -and $answer.Trim().ToLower().StartsWith('n'))) {
:::    Start-Process -FilePath $VenvPyw -ArgumentList '-m', 'vocabulary_trainer' -WorkingDirectory $InstallRoot
:::    Write-Host ''
:::    Write-Host '  Started. Look for the character near the bottom-right.' -ForegroundColor Green
:::    Write-Host ''
:::}
:::exit 0
